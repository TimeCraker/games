__pycache__/
*.blend1

# 编辑器 / IDE 配置（各端工程会重新生成）
.idea/
.vscode/

# 调试 / 浏览器本地垃圾（不提交）
.ui-polish/
anim_list_out.txt
shot.png
.playwright-mcp/

# 美术验收基线截图（本地比对用，不入库）
sta-baseline-*.png
